{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kinotch:gesture-ime:profile:v2",
  "title": "Gesture IME ProfileBundle v2",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "gesturePolicy",
    "keyDefinitions",
    "layouts",
    "layers",
    "boards",
    "macros"
  ],
  "properties": {
    "schema": {
      "const": "gesture-ime.profile.v2"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "gesturePolicy": {
      "$ref": "#/$defs/gesturePolicy"
    },
    "keyDefinitions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/keyDefinition"
      }
    },
    "layouts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/layout"
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "boards": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/board"
      }
    },
    "macros": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/macro"
      }
    },
    "theme": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 256
        },
        "accessibilityLabel": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": true
    },
    "actionInvocation": {
      "type": "object",
      "required": [
        "actionID",
        "arguments"
      ],
      "properties": {
        "actionID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "arguments": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "actionList": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/actionInvocation"
      }
    },
    "coordinate": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127
        },
        "y": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127
        }
      },
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "required": [
        "targetBoard",
        "lifetime"
      ],
      "properties": {
        "targetBoard": {
          "$ref": "#/$defs/id"
        },
        "lifetime": {
          "enum": [
            "persistent",
            "transient"
          ]
        }
      },
      "additionalProperties": true
    },
    "repeatBehavior": {
      "type": "object",
      "required": [
        "intervalMs",
        "actions"
      ],
      "properties": {
        "intervalMs": {
          "type": "integer",
          "minimum": 16,
          "maximum": 5000
        },
        "actions": {
          "$ref": "#/$defs/actionList"
        }
      },
      "additionalProperties": true
    },
    "holdTrigger": {
      "type": "object",
      "required": [
        "delayMs"
      ],
      "properties": {
        "delayMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        },
        "onStart": {
          "$ref": "#/$defs/actionList"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "repeat": {
          "$ref": "#/$defs/repeatBehavior"
        },
        "suppressOnReleaseAfterStart": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "onStart"
          ]
        },
        {
          "required": [
            "transition"
          ]
        },
        {
          "required": [
            "repeat"
          ]
        }
      ],
      "not": {
        "required": [
          "transition",
          "repeat"
        ]
      },
      "additionalProperties": true
    },
    "boardEntry": {
      "type": "object",
      "required": [
        "coordinate"
      ],
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "onRelease": {
          "$ref": "#/$defs/actionList"
        },
        "onTransition": {
          "$ref": "#/$defs/actionList"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "hold": {
          "$ref": "#/$defs/holdTrigger"
        }
      },
      "anyOf": [
        {
          "required": [
            "onRelease"
          ]
        },
        {
          "required": [
            "transition"
          ]
        },
        {
          "required": [
            "hold"
          ]
        }
      ],
      "additionalProperties": true
    },
    "board": {
      "type": "object",
      "required": [
        "id",
        "entries"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/boardEntry"
          }
        }
      },
      "additionalProperties": true
    },
    "keyBoardRef": {
      "type": "object",
      "required": [
        "keyID",
        "boardRef"
      ],
      "properties": {
        "keyID": {
          "$ref": "#/$defs/id"
        },
        "boardRef": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "keyDefinition": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "role": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": true
    },
    "placement": {
      "type": "object",
      "required": [
        "keyID",
        "row",
        "column"
      ],
      "properties": {
        "keyID": {
          "$ref": "#/$defs/id"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 32
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 32
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": [
        "id",
        "placements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "placements": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/placement"
          }
        }
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "layoutRef",
        "keyBoards"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "layoutRef": {
          "$ref": "#/$defs/id"
        },
        "keyBoards": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/keyBoardRef"
          }
        }
      },
      "additionalProperties": true
    },
    "macro": {
      "type": "object",
      "required": [
        "id",
        "actions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "actions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/actionInvocation"
          }
        }
      },
      "additionalProperties": true
    },
    "gesturePolicy": {
      "type": "object",
      "required": [
        "deadZone",
        "initialCommitDistance",
        "continuationCommitDistance",
        "angularHysteresisDegrees"
      ],
      "properties": {
        "deadZone": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "initialCommitDistance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "continuationCommitDistance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "angularHysteresisDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 45
        }
      },
      "additionalProperties": true
    }
  }
}
